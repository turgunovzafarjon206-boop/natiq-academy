{
  "name": "natiq-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Natiq Academy — onlayn taʼlim boshqaruv platformasi",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "netlify-build": "prisma generate && prisma db push --skip-generate && npm run db:seed && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "engines": { "node": "20.x" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "next-intl": "^3.20.0",
    "recharts": "^2.13.0",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
