// ============================================================================
//  Natiq Academy — Prisma schema
//  Normalizatsiya qilingan relatsion sxema. Yagona markaziy PostgreSQL bazasi.
//  Barcha rollar bitta `User` orqali; rol-profil jadvallari 1:1 bogʻlanadi.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- ENUMS
enum RoleKey {
  SUPER_ADMIN
  CEO
  ACADEMIC_DIRECTOR
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum Locale {
  UZ
  RU
  EN
  AR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum CourseLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  AUDIO
  PDF
  TEXT
  PRESENTATION
  INTERACTIVE
  LIVE
}

enum MaterialKind {
  VIDEO
  AUDIO
  PDF
  IMAGE
  PRESENTATION
  LINK
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  ORDERING
  AUDIO
  IMAGE
}

enum SubmissionStatus {
  PENDING     // topshirilmagan / kutilmoqda
  SUBMITTED   // topshirilgan
  GRADED      // baholangan
  REVISION    // qayta ishlash soʻralgan
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum PaymentProvider {
  MANUAL
  CLICK
  PAYME
  UZUM
}

enum LiveLessonStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum NotificationChannel {
  PLATFORM
  TELEGRAM
  EMAIL
  SMS
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  REMINDER
}

enum LeadStage {
  LEAD
  CONTACTED
  TRIAL
  CONSULTATION
  PAYMENT
  STUDENT
  ACTIVE
  COMPLETED
  LOST
}

enum LeadSource {
  INSTAGRAM
  TELEGRAM
  WEBSITE
  REFERRAL
  ADVERTISEMENT
  OTHER
}

// ---------------------------------------------------------------- IDENTITY & RBAC
model User {
  id           String     @id @default(uuid())
  fullName     String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  locale       Locale     @default(UZ)
  telegramId   BigInt?    @unique
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  student      Student?
  teacher      Teacher?
  parent       Parent?
  notifications Notification[]
  auditLogs    AuditLog[]  @relation("actor")
  sessions     Session[]

  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  key         RoleKey          @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique // masalan: "student.create"
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- ROLE PROFILES
model Branch {
  id       String    @id @default(uuid())
  name     String
  address  String?
  students Student[]
}

model Student {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String       @unique // NAT-2026-000123
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id])
  parentId    String?
  parent      Parent?      @relation(fields: [parentId], references: [id])
  xp          Int          @default(0)
  streak      Int          @default(0)
  createdAt   DateTime     @default(now())

  enrollments   Enrollment[]
  attendances   Attendance[]
  submissions   HomeworkSubmission[]
  quizAttempts  QuizAttempt[]
  payments      Payment[]
  certificates  Certificate[]
  achievements  StudentAchievement[]
  teacherNotes  TeacherNote[]
  lessonProgress LessonProgress[]

  @@index([branchId])
  @@index([parentId])
}

model Teacher {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  subjects  String[]
  courses   Course[]
  groups    Group[]
  notes     TeacherNote[]
}

model Parent {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  children Student[]
}

// ---------------------------------------------------------------- COURSE / LMS
model Course {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  description String?
  level       CourseLevel  @default(BEGINNER)
  price       Decimal      @default(0) @db.Decimal(12, 2)
  thumbnail   String?
  status      CourseStatus @default(DRAFT)
  teacherId   String?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules      Module[]
  groups       Group[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([status])
  @@index([teacherId])
}

model Module {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String       @id @default(uuid())
  moduleId    String
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  type        LessonType   @default(VIDEO)
  durationSec Int          @default(0)
  content     String?      // rich text / HTML

  materials   LessonMaterial[]
  quizzes     Quiz[]
  homeworks   Homework[]
  progress    LessonProgress[]

  @@index([moduleId])
}

model LessonMaterial {
  id         String       @id @default(uuid())
  lessonId   String
  lesson     Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind       MaterialKind
  title      String
  storageKey String       // S3 obyekt kaliti (imzolangan URL orqali beriladi)
  order      Int          @default(0)

  @@index([lessonId])
}

model LessonProgress {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  lastPosition   Int      @default(0) // "toʻxtagan joyingizdan davom eting"
  updatedAt      DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// ---------------------------------------------------------------- GROUPS & ENROLLMENT
model Group {
  id          String    @id @default(uuid())
  code        String    @unique // AR-B1
  name        String
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  schedule    String?   // "Du/Cho/Ju 17:00"

  enrollments Enrollment[]
  attendances Attendance[]
  liveLessons LiveLesson[]

  @@index([courseId])
  @@index([teacherId])
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  progressPct Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([studentId, courseId])
  @@index([groupId])
}

// ---------------------------------------------------------------- ATTENDANCE
model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  liveLessonId String?
  liveLesson   LiveLesson?      @relation(fields: [liveLessonId], references: [id])
  status       AttendanceStatus
  date         DateTime         @db.Date
  createdAt    DateTime         @default(now())

  @@unique([studentId, groupId, date]) // bir kunda bitta yozuv
  @@index([groupId, date])
  @@index([studentId])
}

// ---------------------------------------------------------------- HOMEWORK
model Homework {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxScore    Int      @default(10)
  dueAt       DateTime?
  createdAt   DateTime @default(now())

  submissions HomeworkSubmission[]

  @@index([lessonId])
}

model HomeworkSubmission {
  id         String           @id @default(uuid())
  homeworkId String
  homework   Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentText String?
  files      Json?            // [{kind, storageKey}] — text/image/pdf/audio/video
  status     SubmissionStatus @default(PENDING)
  score      Int?
  feedback   String?
  submittedAt DateTime?
  gradedAt    DateTime?

  @@unique([homeworkId, studentId])
  @@index([status])
}

// ---------------------------------------------------------------- QUIZ / EXAM
model Quiz {
  id           String   @id @default(uuid())
  lessonId     String?
  lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  timeLimitSec Int?
  passingScore Int      @default(60) // %
  attemptLimit Int      @default(1)
  createdAt    DateTime @default(now())

  questions Question[]
  attempts  QuizAttempt[]

  @@index([lessonId])
}

model Question {
  id       String       @id @default(uuid())
  quizId   String
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type     QuestionType
  text     String
  points   Int          @default(1)
  order    Int          @default(0)
  mediaKey String?      // audio/image savollar uchun
  answers  Answer[]

  @@index([quizId])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

model QuizAttempt {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score         Int      @default(0)
  percentage    Int      @default(0)
  passed        Boolean  @default(false)
  correctCount  Int      @default(0)
  answers       Json?    // {questionId: answerId|value}
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([quizId])
  @@index([studentId])
}

// ---------------------------------------------------------------- PAYMENT
model Payment {
  id            String          @id @default(uuid())
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String?
  amount        Decimal         @db.Decimal(12, 2)
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(MANUAL)
  providerTxnId String?         @unique // idempotency / webhook moslashuvi
  dueDate       DateTime?       @db.Date
  paidAt        DateTime?
  createdAt     DateTime        @default(now())

  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------- CERTIFICATE
model Certificate {
  id         String   @id @default(uuid())
  publicId   String   @unique // NAT-2026-000123 — ochiq tekshiruv
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  level      String
  pdfKey     String?
  qrUrl      String?
  issuedAt   DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------- LIVE LESSON
model LiveLesson {
  id          String           @id @default(uuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime
  durationMin Int              @default(60)
  meetingUrl  String?          // Zoom / Meet / custom
  status      LiveLessonStatus @default(SCHEDULED)
  attendances Attendance[]

  @@index([groupId, startsAt])
}

// ---------------------------------------------------------------- NOTIFICATION
model Notification {
  id       String              @id @default(uuid())
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel  NotificationChannel @default(PLATFORM)
  type     NotificationType    @default(INFO)
  title    String
  body     String?
  data     Json?
  readAt   DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, readAt])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  audience  Json?    // {roles:[], groupIds:[], courseIds:[]}
  createdBy String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- GAMIFICATION
model Achievement {
  id       String @id @default(uuid())
  code     String @unique // FIRST_COURSE, STREAK_7, XP_1000 ...
  title    String
  icon     String // emoji yoki storage key
  xpReward Int    @default(0)
  students StudentAchievement[]
}

model StudentAchievement {
  studentId     String
  achievementId String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@id([studentId, achievementId])
}

// ---------------------------------------------------------------- CRM (future-ready)
model Lead {
  id        String     @id @default(uuid())
  fullName  String
  phone     String
  source    LeadSource @default(WEBSITE)
  stage     LeadStage  @default(LEAD)
  courseId  String?
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([stage])
  @@index([source])
}

// ---------------------------------------------------------------- TEACHER NOTES
model TeacherNote {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------- AUDIT LOG
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation("actor", fields: [actorId], references: [id])
  action    String   // "student.create", "payment.update" ...
  entity    String?  // "Student"
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
